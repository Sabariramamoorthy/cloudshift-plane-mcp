# cloudshift-plane-mcp — example configuration
# Copy to .env and fill in values. Never commit .env.

# -----------------------------------------------------------------------------
# Plane connection (required)
# -----------------------------------------------------------------------------
# Public URL of your Plane instance, without /api (the SDK appends /api/v1).
# Plane Cloud: https://api.plane.so
PLANE_BASE_URL=https://plane.example.com

# Workspace API token (Plane → Workspace settings → API tokens).
PLANE_API_KEY=

# Workspace slug from your Plane URL: https://plane.example.com/<slug>/projects
PLANE_WORKSPACE_SLUG=my-workspace

# Optional: internal URL for server-to-server calls (e.g. a private network
# address). Falls back to PLANE_BASE_URL.
# PLANE_INTERNAL_BASE_URL=http://plane-api:8000

# -----------------------------------------------------------------------------
# HTTP server (only for `plane-mcp-server http`)
# -----------------------------------------------------------------------------
MCP_HOST=0.0.0.0
MCP_PORT=8211
# Prefix all routes, e.g. when reverse-proxying under a sub-path.
# MCP_PATH_PREFIX=

# API-key-only mode (recommended for self-hosted Plane CE and Claude.ai).
# Mounts only /http/api-key/... and hides OAuth discovery endpoints.
PLANE_MCP_DISABLE_OAUTH=true

# Allow URL-only clients (Claude.ai custom connectors) on
# /http/api-key/w/<workspace>/mcp. When the client sends no credentials, the
# server uses PLANE_API_KEY. Anyone who can reach that URL gets this key's
# access — only enable behind a private network or an authenticating proxy.
PLANE_MCP_ALLOW_URL_ONLY_AUTH=false

# -----------------------------------------------------------------------------
# OAuth (only when PLANE_MCP_DISABLE_OAUTH=false)
# -----------------------------------------------------------------------------
# Public URL of THIS MCP server (not the Plane URL).
# PLANE_OAUTH_PROVIDER_BASE_URL=https://mcp.example.com
# PLANE_OAUTH_PROVIDER_CLIENT_ID=
# PLANE_OAUTH_PROVIDER_CLIENT_SECRET=
# PLANE_OAUTH_PROVIDER_ENABLE_CIMD=false
# Extra redirect URI patterns (comma-separated) appended to the built-in allowlist.
# PLANE_OAUTH_ALLOWED_REDIRECT_URIS=https://newclient.example/cb

# Token storage for OAuth (falls back to in-memory without Redis).
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Reports (cloudshift_plane_* tools)
# -----------------------------------------------------------------------------
# IANA timezone used for "today", overdue, and due-soon calculations.
CLOUDSHIFT_TIMEZONE=UTC
# Open items not updated for this many days are flagged stale.
CLOUDSHIFT_STALE_TASK_DAYS=5
# Items due within this many hours are flagged due-soon.
CLOUDSHIFT_DUE_SOON_HOURS=48
# Labels that mark an item as blocked (comma-separated, case-insensitive).
CLOUDSHIFT_BLOCKED_LABEL_NAMES=blocked,blocker,blocking

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Include display names (PII) in logs. Default false.
# LOG_USER_INFO=false
